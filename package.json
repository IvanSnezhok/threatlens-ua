{
  "name": "threatlens-ua",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first alerts, threats and risk assessments for Ukraine",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "esbuild web/app.js --bundle --sourcemap --outfile=public/assets/app.js --loader:.css=css --external:/assets/fonts/* --watch",
    "build:web": "esbuild web/app.js --bundle --minify --outfile=public/assets/app.js --loader:.css=css --external:/assets/fonts/*",
    "build": "npm run build:web && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.6.0",
    "fflate": "^0.8.3",
    "grammy": "^1.38.3",
    "maplibre-gl": "^5.7.1",
    "pg": "^8.16.3",
    "pino": "^9.9.4",
    "polygon-clipping": "^0.15.7",
    "prom-client": "^15.1.3",
    "teleproto": "^1.228.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.18.8",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.25.10",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.4"
  }
}
