# ================================================================================================
# This file is the BOOTSTRAP, not the source of truth.
#
# Since migration 030 most of these values also live in PostgreSQL (`app_settings`), and a stored
# value WINS over the one in this file. The operator edits them at /ops/settings — a running
# deployment does not have to be stopped, and this file does not have to be touched, to change a
# poll interval, a token or a model name.
#
# What this file is still for:
#   * the first boot, before there is a database to read anything out of;
#   * the keys marked below, which can only ever be set here.
#
# Two markers appear on the right of a line:
#
#   [тільки .env]                  the settings registry knows this key and deliberately refuses to
#                                  store it. Four reasons, one per key: it is needed before the
#                                  database is open (NODE_ENV, PORT, DATABASE_URL), it is consumed
#                                  by compose or baked into the image (PORT, APP_COMMIT,
#                                  CODEX_OAUTH_REDIRECT_PORT), it is the lock on the very page that
#                                  would edit it (OPS_USER, OPS_PASSWORD), or it is a secret shared
#                                  with another container that never reads this database
#                                  (METRICS_TOKEN, DEPLOY_RUNNER_TOKEN).
#
#   [тільки .env · поза реєстром]  the application has never heard of this key at all. It is read by
#                                  compose, by Caddy, by `postgres`, by `backup` or by the
#                                  `deployer` container — none of which can read `app_settings`.
#
# An unmarked key may be set here and then changed from /ops/settings at any time. The authoritative
# list is the one the page itself shows under «Тільки в .env»; it is generated from the registry in
# src/config.ts, so it cannot drift from the code the way a hand-kept list in a comment would.
#
# APP_COMMIT and APP_BUILT_AT are [тільки .env] too but are absent from this file on purpose: they
# are build args, set by `docker compose build`, and an image that reports a value typed in here
# would be an image lying about what it is.
#
# See docs/TOKENS.md for how to obtain each credential and where it lives afterwards.
# ================================================================================================
NODE_ENV=development # [тільки .env]
PORT=3000 # [тільки .env]
APP_TIMEZONE=Europe/Kyiv
PUBLIC_URL=http://localhost:3000 # [тільки .env]
PUBLIC_HOST=localhost # [тільки .env · поза реєстром]
SITE_ADDRESS=http://localhost # [тільки .env · поза реєстром]
HTTP_PORT=8080 # [тільки .env · поза реєстром]
HTTPS_PORT=8443 # [тільки .env · поза реєстром]
APP_HTTP_PORT=13000 # [тільки .env · поза реєстром]
DATABASE_URL=postgresql://threatlens:threatlens@postgres:5432/threatlens # [тільки .env]
POSTGRES_DB=threatlens # [тільки .env · поза реєстром]
POSTGRES_USER=threatlens # [тільки .env · поза реєстром]
POSTGRES_PASSWORD=change-me # [тільки .env · поза реєстром]
# Used only by the isolated backup restore verification command.
POSTGRES_ADMIN_URL=postgresql://threatlens:change-me@postgres:5432/postgres # [тільки .env · поза реєстром]

# Bot delivery. Leave empty to run without Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_DELIVERY_RATE_PER_SECOND=25
TELEGRAM_DELIVERY_BURST=25

# MTProto public-channel collector. Leave empty to disable.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Official and secondary source access.
# Both API adapters need a token issued on written application and stay disabled without one.
UKRAINE_ALARM_API_TOKEN=
UKRAINE_ALARM_API_URL=https://api.ukrainealarm.com/api/v3/alerts
ALERTS_IN_UA_TOKEN=
ALERTS_IN_UA_URL=https://api.alerts.in.ua/v1/alerts/active.json
DEMO_SOURCE_ENABLED=true # [тільки .env]

# Community aerial-alert mirror — the one HTTP alert source that needs no token.
# https://ubilling.net.ua/aerialalerts/ republishes the same executive-authority air-raid state the
# two APIs above serve, free, no key, no application. It is what gives a deployment live alert data
# while the API applications are pending.
#
# ON by default, because there is no credential to withhold — this switch is the only "off" this
# source has, the same shape as ALERT_CHANNEL_ENABLED. Turning it off stops the source being READ;
# it does not withdraw alerts it was holding at the time. See docs/OPERATIONS.md.
#
# Read migrations/027 before trusting it for anything: `?source=default` is an aggregator that may
# be serving Alerts.in.ua or Ukraine Alarm on any given poll, so it corroborates them barely at all,
# and its own operator says "do not perceive this API as absolutely reliable".
AERIAL_MIRROR_ENABLED=true
AERIAL_MIRROR_URL=https://ubilling.net.ua/aerialalerts/
# Safety bound, not a tuning knob. Past this age the mirror's own `cachedat` stamp is treated as a
# source ERROR and NOTHING is written, so a frozen mirror serving "no alerts anywhere" can never
# clear the map. Measured: `cachedat` stayed within two seconds of the request across thirteen
# consecutive fifteen-second polls, so 300 is ~100x the observed lag. Floor 60.
AERIAL_MIRROR_STALE_SECONDS=300
# Which upstream to read through the mirror's documented `?source=<x>&raw` passthrough, which hands
# back that upstream's NATIVE body instead of the aggregated oblast-only digest.
#
# `ual` (Ukraine Alarm) is the default because it is the only probed upstream that publishes below
# oblast level: `State`, `District` (район) and `Community` (громада, folded into its район by the
# catalogue). One live poll: 3 State + 26 District + 5 Community entries while the aggregated feed,
# polled 26 seconds later, had nine oblasts and nothing finer — plus a Crimea row it never carries.
# `klimenko` serves the envelope with an empty district list, `jaam` returns [], `aiu` 429s readily.
#
# SET IT EMPTY to switch the passthrough off and restore oblast-only behaviour exactly as this
# source shipped: one request per poll, twenty-five rows. That is the intended response if the
# upstream ever reshapes its body — a full retreat to a known-good path, not a degraded mode.
AERIAL_MIRROR_RAW_SOURCE=ual
# Pause between the raw poll and the aggregated cross-check, when a cross-check is needed at all.
#
# The steady state is ONE request per poll; the second is made only when the raw feed reports nothing
# alight (is the country quiet, or is the upstream broken?) or could not be read. The endpoint
# publishes two requests per second per host, and during research two requests inside one second were
# answered with a truncated body — the exact failure the parsers refuse. So the two are sequenced,
# never fired together, and this is the gap. Do not set it to 0 outside tests.
AERIAL_MIRROR_REQUEST_GAP_MS=600

# Official alert channels, read through the MTProto collector above.
# Fed by the executive authorities, the oblast and city military administrations and the State
# Emergency Service; no token, no application. This is what makes official alerts work without an
# API contract, and it needs only the TELEGRAM_API_* credentials already configured for the
# collector.
#
# WHICH channels are read is data, not configuration: every row in `sources` with
# adapter_type='mtproto_alert_channel' and enabled=true is subscribed to and may start and end
# official alert periods. Twenty-one bodies are registered and the ones whose published wording the
# parser has actually been shown are switched on — see migrations/013 and 014 for the list and the
# evidence behind each flag. ALERT_CHANNEL_ENABLED is the deployment-level kill switch above all of
# them, the same shape as OSINT_MONITOR_ENABLED below.
ALERT_CHANNEL_ENABLED=true
# Fallback only: the single channel the collector subscribes to if the `sources` query fails, so a
# database hiccup cannot leave the deployment with no official alert source at all. When the query
# succeeds, the table decides and this value is not consulted.
ALERT_CHANNEL_USERNAME=air_alert_ua
# The channel publishes events ("alert started in X" / "all-clear in Y"), not snapshots, so a lost
# or unparsable all-clear would otherwise leave an alert active forever. This is the backstop: the
# longest an alert from this source may stay up without an explicit all-clear. It is set far above
# any real alert on purpose — firing it means a message was missed, and it is logged and counted as
# such. Lowering it towards a plausible alert duration would turn it into a false "Офіційний
# відбій" generator. Values below 3600 are rejected at startup.
ALERT_CHANNEL_MAX_ALERT_SECONDS=43200
# How long the collector may receive NOTHING — across every subscribed channel at once — before the
# heartbeat stops marking the sources fresh. It exists because being subscribed is not the same as
# receiving: a collector can hold `collector_ready 1` and advance `last_success_at` every minute
# while its updates loop is dead, and an all-clear published in that window never reaches the map.
# Past this window the heartbeat writes nothing and the sources go stale on their own, which is the
# honest state. Watch `threatlens_telegram_seconds_since_update` and
# `threatlens_telegram_silent_heartbeats_total`. Zero disables the check.
TELEGRAM_SILENCE_ALERT_SECONDS=1800
# History re-read from each alert channel once the collector connects, so a restart does not leave
# the state stale. The window is folded to one current state per location before anything is
# written, so nothing inside it is replayed as a fresh notification. Set the message count to 0 to
# disable the backfill.
#
# The message count is a per-channel ceiling, not a target: the collector reads a page at a time and
# stops as soon as it runs past ALERT_CHANNEL_BACKFILL_SECONDS. 300 is calibrated to the busiest
# channel (@air_alert_ua publishes ~50 messages an hour, so ~300 fill the six-hour window); an
# oblast administration publishes one to three an hour and finishes in a single page.
ALERT_CHANNEL_BACKFILL_MESSAGES=500
ALERT_CHANNEL_BACKFILL_SECONDS=43200

# OSINT air-threat monitoring channels, read through the same MTProto collector.
# Which channels are read is data, not configuration: the list lives in the `sources` table, one row
# per channel, carrying the username, the tier and the independence group. Adding or removing a
# channel is a row change, and a row with enabled=false is genuinely not collected.
# None of these channels can start or end an official alert. They are official=false monitoring
# sources on the classifier path: their messages become threat events, never alert periods, even
# when the text literally says "тривога" or "відбій".
OSINT_MONITOR_ENABLED=true
# Longest a monitoring channel may keep restating the same threat type over the same places before
# it raises the event again. These channels post continuously during an attack and a restatement
# re-notifies every subscriber of that location, because the outbox idempotency key carries the
# event-log version. The message itself is still stored; only the repeat notification is suppressed.
# Far below the 30-minute event validity window, so a suppressed repeat cannot let a live threat
# expire. 0 disables it; values above 900 are rejected at startup.
OSINT_MONITOR_COALESCE_SECONDS=120

# ---- Catch-up backfill after downtime ------------------------------------------------------------
# After an interruption the collector reads what it missed for every enabled CLASSIFIER Telegram
# source. Official alert channels are not covered here: they have their own reconnect path above
# (ALERT_CHANNEL_BACKFILL_*), because their messages are state transitions that get folded to one
# terminal state per location, and these are events that get archived one by one.
#
# A replayed message keeps its original published_at, external_id and provenance, and one older than
# its own 30-minute validity window is archived WITHOUT becoming a live threat and WITHOUT a
# notification: history is not news.
# CLASSIFIER_BACKFILL_ENABLED=true
# The gap that separates "the collector blinked" from "the collector was down". Below it nothing
# extra happens — live collection alone covers a short interruption, and a catch-up read on every
# reconnect would be a history burst on every flap. Values below 300 are rejected at startup.
# CLASSIFIER_BACKFILL_MIN_GAP_SECONDS=3600
# How far back one catch-up may reach whatever the gap says. Six hours matches the risk horizon:
# older than that, a message is archive material. Ceiling 172800 (48 h).
# CLASSIFIER_BACKFILL_MAX_AGE_SECONDS=21600
# Per-source ceilings on one catch-up. Hitting either is `truncated` — a bounded success shown in
# /ops as «дозбір обмежено», not as a failure.
# CLASSIFIER_BACKFILL_MAX_MESSAGES=300
# CLASSIFIER_BACKFILL_MAX_PAGES=5
# CLASSIFIER_BACKFILL_PAGE_SIZE=100
# The request budget of one sweep: how many sources it may touch and how long it pauses between
# them. Deliberately gentle — this shares one Telegram account with the live collector, and a burst
# that earns a flood wait stops live collection for every channel.
# CLASSIFIER_BACKFILL_MAX_SOURCES_PER_SWEEP=10
# CLASSIFIER_BACKFILL_SOURCE_DELAY_MS=1500
# Base of the exponential re-run guard: a failing source waits MIN_RERUN_SECONDS * min(2^failures, 24)
# before it is read again, so a poison message costs one read a day rather than one every sweep.
# CLASSIFIER_BACKFILL_MIN_RERUN_SECONDS=3600
# How often the sweep re-evaluates every source. 0 = only once, at collector start.
# CLASSIFIER_BACKFILL_CHECK_INTERVAL_SECONDS=300

# Gap between two passes of an ALERT-STATE leg: the community mirror and the two token APIs. It is
# the front of the end-to-end budget, and it is a request GAP rather than a period — the next pass is
# armed when the previous one finishes, so a slow upstream is never answered with a burst.
#
# Per-provider floors clamp it from below and CANNOT be configured away, because each is somebody
# else's published number: the mirror 3 s (its own documented cache TTL, behind a 2 rps/host limit),
# alerts.in.ua 7 s (8.6 req/min against a 12/min hard limit and an 8-10/min soft band), Ukraine Alarm
# 15 s (nothing is documented for that API, and an undocumented budget is not a budget to spend
# against). Accepted range 2-60; the default of 4 is the mirror's real cadence.
#
# Also settable from /ops, where it is `hot`: the scheduler reads it on every tick and no restart is
# needed, but a change takes effect from the NEXT pass, not from the one already being waited out.
# ALERT_POLL_INTERVAL_SECONDS=4

# How long a source may stay silent about an alert it was holding before that alert may end.
# Measured against the SLOWEST alert leg, Ukraine Alarm at 15 s, so 60 tolerates three consecutive
# missed polls of it and correspondingly more of the faster legs; a single incomplete response can no
# longer produce a false "Офіційний відбій". Raising it delays every genuine all-clear by the same
# amount. Values below 30 (two of those polls) are rejected at startup.
ALERT_END_DEBOUNCE_SECONDS=60
# The mirror image of the debounce: how long a source may keep HOLDING an alert while showing no
# sign of life at all. The debounce protects a source that went quiet for a moment; this one stops a
# source that has gone quiet for good from pinning a location under alert forever. On 2026-08-12 the
# MTProto collector held Kyiv from 09:53 UTC while receiving nothing, the independent HTTP mirror
# cleared Kyiv at 11:33 UTC correctly, and the map still showed an alert at 16:23 — the aggregate
# weighed a five-hour-old row as heavily as a fresh one. Liveness is read from sources.last_success_at.
# An hour is deliberately generous. Raise it, never lower it, if a slow source starts being
# discounted; watch threatlens_alert_stale_sources_ignored_total. Values below 600 are rejected.
ALERT_SOURCE_LIVENESS_SECONDS=3600

# OpenAI-compatible structured assessment endpoint. Leave empty for rule fallback.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000
# Audio transcription uses the same OpenAI-compatible API base/key, not the ChatGPT OAuth session.
# AI_TRANSCRIPTION_MODEL=gpt-transcribe
NIGHTLY_DIGEST_TIME=23:20

# Скільки секунд утримувати публічний показ у режимі delayed_15s.
# Сам режим (live | delayed_15s) вмикає оператор у /ops і зберігається в таблиці runtime_settings —
# у .env лише довжина затримки. Значення менші за 5 і більші за 60 відхиляються на старті:
# нижче 5 с затримка не відрізняється від тремтіння опитування, вище 60 с клієнт позначить дані
# як застарілі, хоча затримку задав оператор.
# PUBLICATION_DELAY_SECONDS=15

# Чи можна публікувати щось у власний Telegram-канал проєкту (міграція 044).
# Які саме канали існують — це дані, а не конфігурація: публікація йде в кожен рядок
# publication_channels з enabled=true, так само як ALERT_CHANNEL_ENABLED стоїть над реєстром джерел.
# У канал потрапляють ЛИШЕ події з origin='model' — неперевірені оцінки моделі; офіційні тривоги й
# відбої цим шляхом не йдуть узагалі. Одна подія — одне повідомлення в канал, назавжди.
# Типово вимкнено, і це третій вимикач перед тією самою поведінкою: модель має право створити подію
# (codex_settings.analytical_threats_enabled), оператор має увімкнути канал, і має бути ця змінна.
# PUBLICATION_CHANNEL_ENABLED=false

# Аварійний вимикач подієвого перерахунку аналітики на рівні розгортання. false — воркер не
# підписується на шину подій узагалі, лишаються тільки п'ятнадцятихвилинні таймери.
# Причина вимкнути його — це майже завжди проблема з базою, тобто найгірший момент для того,
# щоб читати прапорець із бази.
# ANALYTICS_EVENT_DRIVEN_ENABLED=true

# Written conclusion on top of /ops/api/analytics/*. Optional in the strict sense: every number the
# analytics report is deterministic SQL and is identical whether this is on or off — a model only
# ever writes the prose, and a narrative stating a number the aggregates do not support is discarded
# in favour of the deterministic text. Leave false unless somebody is reading the prose.
ANALYTICS_NARRATIVE_ENABLED=false
# Codex over ChatGPT OAuth, kept separate from AI_* so the two can differ. With CODEX_* empty the
# narrative falls back to AI_*, and then to no model at all.
#
# BASE_URL and MODEL still have to be set here — signing in supplies a token, not an endpoint.
# CODEX_API_KEY and CODEX_ACCOUNT_ID are now only a fallback: press "Увійти через ChatGPT" in /ops
# and the session is stored in PostgreSQL and refreshed automatically, which the two variables
# below cannot be. A stored session always wins over them.
#
# CODEX_MODEL is now a default rather than the decision: /ops → «Codex-аналітика» lets an operator
# pick a model from the list the service reports and switch the three surfaces on or off
# individually (наратив аналітики, нічний дайджест, аналіз атак). Those choices live in
# `codex_settings` and survive a restart. Leaving the dropdown on «за замовчуванням» uses this value,
# so an installation that never opens the console behaves exactly as it did before.
# For inference on a ChatGPT plan point this at the Codex backend; the client then speaks the
# Responses API over SSE, exactly as the Codex CLI does. An OpenAI-compatible proxy also works —
# the transport is chosen from the URL (see CODEX_API_STYLE to override).
# CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
CODEX_BASE_URL=
CODEX_API_KEY=
CODEX_MODEL=
CODEX_ACCOUNT_ID=
# auto | chat | responses. `auto` sends the Responses-API shape to chatgpt.com/backend-api and
# `chat/completions` everywhere else, which is right unless a proxy squats on the wrong URL.
CODEX_API_STYLE=auto

# Shadow classification: a model reads the same messages the rules already judged and stores its
# verdict beside theirs. A separate off-by-default /ops switch may promote a strictly bounded verdict
# to an unverified analytical event; official alerts and withdrawals remain unreachable.
#
# There is no ON switch here on purpose. The feature is turned on in /ops («Тіньова класифікація»),
# because the reason to turn it off is usually an exhausted quota during an attack, and that is the
# worst possible moment to edit this file and restart the container. What lives here is only the
# spending ceiling: how many messages a minute may be sent. Messages over budget are dropped, not
# queued — a queue would hand back the spend it was meant to prevent, one minute late.
# SHADOW_CLASSIFIER_MAX_PER_MINUTE=6
# SHADOW_CONTEXT_MESSAGES=8
# SHADOW_CONTEXT_MINUTES=30
# SHADOW_IMAGE_MAX_BYTES=8000000
# SHADOW_AUDIO_MAX_BYTES=25000000
# Minimum confidence for /ops «Аналітичні загрози». Catalogued geography and a current assertion
# are still mandatory; every created event remains unverified.
# ANALYTICAL_THREAT_MIN_CONFIDENCE=0.9
# The publication ceiling, counted separately from the call budget above: how many unverified
# analytical events may reach the map and the channel in a rolling hour. Two windows because raising
# the call budget to collect more labelling material during an attack must not also raise how much a
# drifting model may publish. 0 stops promotions entirely while the shadow comparisons keep being
# written — the emergency stop for when /ops is not reachable.
# ANALYTICAL_PROMOTIONS_MAX_PER_HOUR=12
# How long an analytical event may stand with nothing corroborating it before the system closes it
# itself. The ceiling above bounds how many wrong pins may appear; this bounds how long each one
# stays. Corroboration means a message the deterministic rules themselves accepted has been attached
# to the same event — a second model verdict does not count.
#
# 0 (the default) switches the sweep off entirely, and off is the honest default: the event's own
# `valid_until` promises thirty minutes, and closing it sooner means the map stops honouring a
# deadline it published. Turn it on only if this installation would rather lose a true analytical
# warning early than keep a false one on the map. Accepted values are 0 or 5..29 — 30 and above would
# be a setting that reads as configured and does nothing, because the validity window retires the
# event at thirty minutes anyway.
#
# Nothing calls the sweep until a scheduler is wired to it; with no scheduler this setting is inert.
# ANALYTICAL_UNCONFIRMED_CLOSE_MINUTES=0

# Retrospective gate: the ONE place in this system where a model's answer changes what the pipeline
# does. Classifier `v5` refuses a message that reads as a report about a period that has ended — a
# night summary, an after-action account, an essay — and publishes one that also states something
# happening now. Between those sits a grey band the rules will not decide on their own, and with this
# feature on, a model is asked one question about it: «is this current, or retrospective?»
#
# The only thing it may do with the answer is turn a threat the rules WOULD have published into an
# archive-only row. It cannot create, escalate, resurrect or widen anything, and every failure —
# switched off, over budget, no session, timed out, unparseable — leaves the deterministic verdict
# standing, which is to publish. See src/services/retrospective-gate.ts.
#
# There is no ON switch here, for the same reason the shadow classifier has none: it is turned on in
# /ops («Підтвердження ретроспективи»), off by default, because the moment you want it off is usually
# the middle of an attack. What lives here are the two bounds.
#
# The timeout is a safety bound, not a preference: this call is awaited inside ingestion, so a
# message waiting on the model is a message not yet on the map. 2.5 s against a 30-minute event
# validity window. Range 250…10000.
# RETROSPECTIVE_GATE_TIMEOUT_MS=2500
# Spending ceiling per rolling minute. Over budget the gate publishes, so an exhausted quota can
# only ever cost a suppression, never a warning. Range 0…120.
# RETROSPECTIVE_GATE_MAX_PER_MINUTE=6

# The two bounds on the operator-only oblast research memo (/ops → «Дослідження області»). Both are
# counted from the request table rather than from a counter in memory, so a restart does not hand
# anybody a fresh allowance — and they deliberately count different things.
#
# Presses per day, refusals INCLUDED: pressing the button is what an operator spends, and a stuck
# client has to be bounded by something. 0 closes the surface entirely. Range 0…200.
# ATTACK_RESEARCH_MAX_PER_DAY=20
# Pause between two memos for the same (oblast, window) pair, counted only from requests that
# actually produced one — so a press that was refused does not make you wait for a computation that
# never ran. 0 disables the pause. Range 0…3600.
# ATTACK_RESEARCH_COOLDOWN_SECONDS=120

# Where the sign-in button sends the browser, and where it comes back to. The defaults are the ones
# the Codex CLI uses and normally need no change. The redirect is loopback because that client
# accepts no other: the browser finishing the sign-in and this app must share one localhost, so the
# button works on your own machine and not on a remote host behind Caddy.
# CODEX_OAUTH_ISSUER=https://auth.openai.com
# CODEX_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
# CODEX_OAUTH_SCOPE=openid profile email offline_access
# CODEX_OAUTH_REDIRECT_PORT=1455 # [тільки .env]
# CODEX_OAUTH_REDIRECT_HOST=localhost
# CODEX_OAUTH_BIND_ADDRESS=0.0.0.0 # [тільки .env]
# CODEX_OAUTH_LOGIN_TIMEOUT_SECONDS=300

# Read-only operations page, protected again at the app layer.
OPS_USER=operator # [тільки .env]
OPS_PASSWORD=change-me # [тільки .env]
METRICS_TOKEN= # [тільки .env]

# Frontend map style. Production should point to a self-hosted PMTiles style.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Official KATOTTG city catalog; no registration or token required.
KATOTTG_SYNC_ENABLED=true
KATOTTG_URL=https://mindev.gov.ua/storage/app/sites/1/uploaded-files/kodifikator-07-07.xlsx
KATOTTG_VERSION=07.07.2026

# Temporarily occupied territories layer (DeepStateMap). The feed is not published under an open
# licence: attribution is mandatory and the source must stay switchable with a single flag.
# Only territory inside the internationally recognised border of Ukraine is ever rendered.
OCCUPATION_SOURCE_ENABLED=true
DEEPSTATE_API_URL=https://deepstatemap.live/api/history/last
# Upstream publishes roughly once a day; polling more often than hourly is rejected at startup.
OCCUPATION_SYNC_INTERVAL_SECONDS=10800
OCCUPATION_STALE_AFTER_SECONDS=21600

# Local PostgreSQL backup retention and cadence.
BACKUP_RETENTION_DAYS=14 # [тільки .env · поза реєстром]
BACKUP_INTERVAL_SECONDS=86400 # [тільки .env · поза реєстром]

# ---- Operator-controlled deployment from /ops ----------------------------------------------------
# OFF by default, and off is a complete, supported configuration: the update block in /ops then says
# so and no `deployer` container is needed. Full runbook: docs/OPERATIONS.md, "Deployment from /ops".
#
# The app NEVER holds the Docker socket. Everything below is about reaching a separate `deployer`
# container that does, runs one frozen scenario (fetch origin/main → build → migrate → up app+caddy →
# wait for /health/ready) and writes its journal straight into PostgreSQL. It publishes no host port.
#
# Before turning this on:
#   1. Put the checkout at an absolute path and set DEPLOY_REPO_PATH to it. It is mounted at the SAME
#      path inside the container, because `docker compose` runs in there and the daemon resolves the
#      file's relative bind mounts out here.
#   2. Generate the token:  openssl rand -hex 32
#   3. Start the runner once by hand:  docker compose up -d deployer
#      (the update scenario deliberately never restarts it — a runner that replaces itself mid-run
#      cannot report its own outcome, and pushing to main must not be a way to swap the runner.)
#   4. Protect the `main` branch on GitHub. Anyone who can write main ships code the moment an
#      operator presses the button; that is a stated prerequisite, not a bug.
# DEPLOY_ENABLED=false # [тільки .env]
# DEPLOY_REPO_PATH=/opt/threatlens-ua # [тільки .env · поза реєстром]
# DEPLOY_REPO_URL=https://github.com/IvanSnezhok/threatlens-ua.git # [тільки .env · поза реєстром]
# DEPLOY_RUNNER_TOKEN= # [тільки .env]
# Compose-network address of the runner, and the budget for the proxy hop. The app never waits for a
# deployment: the trigger returns 202 with a run id and the browser polls the journal.
# DEPLOY_RUNNER_URL=http://deployer:9000 # [тільки .env]
# DEPLOY_RUNNER_TIMEOUT_MS=5000 # [тільки .env]
# Read by the `deployer` container only (compose.yaml passes them through by name).
# How long the new container has to answer /health/ready with the commit that was just deployed.
# DEPLOY_READY_TIMEOUT_SECONDS=300 # [тільки .env · поза реєстром]
# Floor between two accepted triggers. A refusal writes no run row.
# DEPLOY_MIN_INTERVAL_SECONDS=60 # [тільки .env · поза реєстром]
# How often the runner reads origin/main by itself (`git ls-remote`, no fetch). 0 disables it.
# DEPLOY_CHECK_INTERVAL_SECONDS=900 # [тільки .env · поза реєстром]
