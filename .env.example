NODE_ENV=development
PORT=3000
APP_TIMEZONE=Europe/Kyiv
PUBLIC_URL=http://localhost:3000
PUBLIC_HOST=localhost
SITE_ADDRESS=http://localhost
HTTP_PORT=8080
HTTPS_PORT=8443
APP_HTTP_PORT=13000
DATABASE_URL=postgresql://threatlens:threatlens@postgres:5432/threatlens
POSTGRES_DB=threatlens
POSTGRES_USER=threatlens
POSTGRES_PASSWORD=change-me
# Used only by the isolated backup restore verification command.
POSTGRES_ADMIN_URL=postgresql://threatlens:change-me@postgres:5432/postgres

# Bot delivery. Leave empty to run without Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling
TELEGRAM_ADMIN_CHAT_ID=

# MTProto public-channel collector. Leave empty to disable.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Official and secondary source access.
# Both API adapters need a token issued on written application and stay disabled without one.
UKRAINE_ALARM_API_TOKEN=
UKRAINE_ALARM_API_URL=https://api.ukrainealarm.com/api/v3/alerts
ALERTS_IN_UA_TOKEN=
ALERTS_IN_UA_URL=https://api.alerts.in.ua/v1/alerts/active.json
DEMO_SOURCE_ENABLED=true

# Official alert channel https://t.me/air_alert_ua, read through the MTProto collector above.
# Fed by the executive authorities and the State Emergency Service; no token, no application. This
# is the source that makes official alerts work without an API contract, and it needs only the
# TELEGRAM_API_* credentials already configured for the collector.
ALERT_CHANNEL_ENABLED=true
ALERT_CHANNEL_USERNAME=air_alert_ua
# The channel publishes events ("alert started in X" / "all-clear in Y"), not snapshots, so a lost
# or unparsable all-clear would otherwise leave an alert active forever. This is the backstop: the
# longest an alert from this source may stay up without an explicit all-clear. It is set far above
# any real alert on purpose — firing it means a message was missed, and it is logged and counted as
# such. Lowering it towards a plausible alert duration would turn it into a false "Офіційний
# відбій" generator. Values below 3600 are rejected at startup.
ALERT_CHANNEL_MAX_ALERT_SECONDS=86400
# History re-read once the collector connects, so a restart does not leave the state stale. The
# window is folded to one current state per location before anything is written, so nothing inside
# it is replayed as a fresh notification. Set the message count to 0 to disable the backfill.
ALERT_CHANNEL_BACKFILL_MESSAGES=300
ALERT_CHANNEL_BACKFILL_SECONDS=21600

# OSINT air-threat monitoring channels, read through the same MTProto collector.
# Which channels are read is data, not configuration: the list lives in the `sources` table, one row
# per channel, carrying the username, the tier and the independence group. Adding or removing a
# channel is a row change, and a row with enabled=false is genuinely not collected.
# None of these channels can start or end an official alert. They are official=false monitoring
# sources on the classifier path: their messages become threat events, never alert periods, even
# when the text literally says "тривога" or "відбій".
OSINT_MONITOR_ENABLED=true
# Longest a monitoring channel may keep restating the same threat type over the same places before
# it raises the event again. These channels post continuously during an attack and a restatement
# re-notifies every subscriber of that location, because the outbox idempotency key carries the
# event-log version. The message itself is still stored; only the repeat notification is suppressed.
# Far below the 30-minute event validity window, so a suppressed repeat cannot let a live threat
# expire. 0 disables it; values above 900 are rejected at startup.
OSINT_MONITOR_COALESCE_SECONDS=120

# How long a source may stay silent about an alert it was holding before that alert may end.
# Providers are polled every 15 seconds, so 60 tolerates three consecutive missed polls; a single
# incomplete response can no longer produce a false "Офіційний відбій". Raising it delays every
# genuine all-clear by the same amount. Values below 30 (two polls) are rejected at startup.
ALERT_END_DEBOUNCE_SECONDS=60

# OpenAI-compatible structured assessment endpoint. Leave empty for rule fallback.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000
NIGHTLY_DIGEST_TIME=23:20

# Read-only operations page, protected again at the app layer.
OPS_USER=operator
OPS_PASSWORD=change-me
METRICS_TOKEN=

# Frontend map style. Production should point to a self-hosted PMTiles style.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Official KATOTTG city catalog; no registration or token required.
KATOTTG_SYNC_ENABLED=true
KATOTTG_URL=https://mindev.gov.ua/storage/app/sites/1/uploaded-files/kodifikator-07-07.xlsx
KATOTTG_VERSION=07.07.2026

# Temporarily occupied territories layer (DeepStateMap). The feed is not published under an open
# licence: attribution is mandatory and the source must stay switchable with a single flag.
# Only territory inside the internationally recognised border of Ukraine is ever rendered.
OCCUPATION_SOURCE_ENABLED=true
DEEPSTATE_API_URL=https://deepstatemap.live/api/history/last
# Upstream publishes roughly once a day; polling more often than hourly is rejected at startup.
OCCUPATION_SYNC_INTERVAL_SECONDS=10800
OCCUPATION_STALE_AFTER_SECONDS=21600

# Local PostgreSQL backup retention and cadence.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
